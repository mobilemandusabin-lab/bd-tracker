{
  "manifest_version": 3,
  "name": "BD Tracker Extension",
  "version": "1.0.10",
  "description": "Captures listing, QC, and spec events from Nepalcan marketplace",
  "permissions": ["storage", "alarms", "webRequest"],
  "host_permissions": ["https://commerce.thecanbrand.com/*", "https://demo.commerce.thecanbrand.com/*", "http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://commerce.thecanbrand.com/*", "https://demo.commerce.thecanbrand.com/*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://commerce.thecanbrand.com/*", "https://demo.commerce.thecanbrand.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
